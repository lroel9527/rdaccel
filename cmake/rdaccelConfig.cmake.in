@PACKAGE_INIT@

# A static rdaccel needs its private dependencies found here too; a shared
# one has them linked in already.
set(RDACCEL_STATIC @RDACCEL_STATIC@)
if(RDACCEL_STATIC)
  include(CMakeFindDependencyMacro)
  find_dependency(Threads)
  find_dependency(ZLIB)
  if(NOT APPLE)
    find_dependency(PkgConfig)
    pkg_check_modules(FFMPEG REQUIRED IMPORTED_TARGET libavcodec libavutil libswscale)
    pkg_check_modules(X11 REQUIRED IMPORTED_TARGET x11 xext xfixes xrandr)
  endif()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/rdaccelTargets.cmake")
check_required_components(rdaccel)
