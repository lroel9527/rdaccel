@PACKAGE_INIT@

# A static rdaccel needs its private dependencies found here too; a shared
# one has them linked in already.
set(RDACCEL_STATIC @RDACCEL_STATIC@)
if(RDACCEL_STATIC)
  include(CMakeFindDependencyMacro)
  find_dependency(Threads)
  find_dependency(ZLIB)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/rdaccelTargets.cmake")
# A static rdaccel with sound needs the libopus.a installed next to it.
if(RDACCEL_STATIC AND @RDACCEL_AUDIO@)
  find_library(RDACCEL_OPUS_LIBRARY NAMES opus PATHS "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@" NO_DEFAULT_PATH)
  if(NOT RDACCEL_OPUS_LIBRARY)
    set(rdaccel_FOUND FALSE)
    set(rdaccel_NOT_FOUND_MESSAGE "libopus.a is missing next to the static librdaccel.a")
    return()
  endif()
  set_property(TARGET rdaccel::rdaccel APPEND PROPERTY INTERFACE_LINK_LIBRARIES "${RDACCEL_OPUS_LIBRARY}")
endif()
check_required_components(rdaccel)
